generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  owner
  member
}

enum TaskStatus {
  todo
  working
  review
  fix
  done
}

enum PullRequestStatus {
  draft
  review
  fixing
  merged
  closed
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(50)
  email              String           @unique @db.VarChar(254)
  passwordHash       String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  memberships        TeamMember[]
  createdTeams       Team[]           @relation("TeamCreator")
  invitationsCreated TeamInvitation[] @relation("InvitationCreator")
  assignedTasks      Task[]           @relation("TaskAssignee")
  createdTasks       Task[]           @relation("TaskCreator")
  taskComments       TaskComment[]
  chatMessages       ChatMessage[]
  assignedPullRequestShares PullRequestShare[] @relation("PullRequestAssignee")
  createdPullRequestShares  PullRequestShare[] @relation("PullRequestCreator")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(30)
  normalizedName String           @unique @db.VarChar(100)
  timezone       String           @default("Asia/Tokyo") @db.VarChar(64)
  createdById    String?          @db.Uuid
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User?            @relation("TeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members        TeamMember[]
  invitations    TeamInvitation[]
  tasks          Task[]
  chatMessages   ChatMessage[]
  pullRequestShares PullRequestShare[]
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      TeamRole @default(member)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @db.Uuid
  email       String   @db.VarChar(254)
  tokenHash   String   @unique @db.Char(64)
  createdById String   @db.Uuid
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([expiresAt])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  teamId      String     @db.Uuid
  title       String     @db.VarChar(100)
  description String?
  assigneeId  String?    @db.Uuid
  createdById String?    @db.Uuid
  startDate   DateTime   @db.Date
  deadline    DateTime   @db.Date
  status      TaskStatus @default(todo)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  pullRequestShares PullRequestShare[]

  @@index([teamId, deadline, id])
  @@index([teamId, status, id])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String?  @db.Uuid
  message   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt, id])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String?  @db.Uuid
  message   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt, id])
  @@index([userId])
}

model PullRequestShare {
  id          String            @id @default(uuid()) @db.Uuid
  teamId      String            @db.Uuid
  taskId      String?           @db.Uuid
  title       String            @db.VarChar(200)
  url         String            @db.VarChar(2048)
  assigneeId  String?           @db.Uuid
  status      PullRequestStatus @default(draft)
  memo        String?           @db.VarChar(5000)
  createdById String?           @db.Uuid
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignee    User?             @relation("PullRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("PullRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId, updatedAt, id])
  @@index([taskId])
  @@index([assigneeId])
  @@index([createdById])
}
